# Local Go workspace files (relative replace directives are canonical; see
# docs/plans/engineering-conventions.md)
go.work
go.work.sum

# Golden test scratch output
_actual_output.yaml

# Editor and OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Agent working files and local logs (loop-engineering protocol)
.agent/
logs/

# Local Deepr expert-council ideation and MCP wiring: research aids that
# stay on the operator machine, never in the repo (see AGENTS.md).
.deepr/
.mcp.json
hack/deepr-*.ps1
hack/deepr-*.sh

# Windows crash dumps
*.stackdump

# Built binaries (build with -o to a scratch dir). Anchored to the module root
# so an accidental in-module `go build` is ignored without also matching the
# same-named source directories (cmd/<tool>, packages/<tool>), which a bare
# name would swallow (and which --exclude-standard would then hide from the
# gates).
*.exe
/operators/meshtastic-operator/nephmeshctl
/operators/meshtastic-operator/nephmesh-mcp
/operators/meshtastic-operator/spectrum-exporter
/operators/meshtastic-operator/reconcile-demo
